# Required: MongoDB connection string. The server does not listen until this
# database connection succeeds.
MONGODB_URI=

# Required: Firebase Admin service-account JSON for the existing Firebase
# project, supplied as one environment variable. Used for ID-token verification
# and FCM friend-message delivery. Keep this value server-side only.
FIREBASE_SERVICE_ACCOUNT=

# Required when media sharing is enabled. These values are used only by the
# backend to create short-lived signed upload and download URLs. Do not expose
# the service role key in the Android app or any Expo public environment value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=qeluno-media

# Optional bearer token for manually invoking POST /internal/cleanup-media.
# The backend also runs friend-media cleanup every six hours automatically.
MEDIA_CLEANUP_SECRET=
