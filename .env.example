# Required: MongoDB connection string. The server does not listen until this
# database connection succeeds.
MONGODB_URI=

# Optional: Firebase Admin service-account JSON, supplied as one environment
# variable. Required for FCM friend-message delivery.
FIREBASE_SERVICE_ACCOUNT=

# Required when media sharing is enabled. These values are used only by the
# backend to create short-lived signed upload and download URLs. Do not expose
# the service role key in the Android app or any Expo public environment value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=qeluno-media
